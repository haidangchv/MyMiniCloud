resolver 127.0.0.11 valid=5s ipv6=off;
resolver_timeout 3s;

upstream minicloud_web {
    zone minicloud_web 64k;
    server web-frontend-server:80 resolve;
    server web-frontend-server-2:80 resolve;
}

upstream minicloud_app {
    zone minicloud_app 64k;
    server application-backend-server:5000 resolve;
}

upstream minicloud_auth {
    zone minicloud_auth 64k;
    server authentication-identity-server:8080 resolve;
}

server {
    listen 80;
    server_name _;
    absolute_redirect off;

    add_header X-MyMiniCloud-Gateway nginx always;
    add_header X-Upstream-Addr $upstream_addr always;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix "";
    proxy_set_header Forwarded "";

    location = /_gateway/health {
        default_type text/plain;
        return 200 "gateway ok\n";
    }

    location = /gateway-health {
        default_type text/plain;
        return 200 "gateway ok\n";
    }

    location /api/ {
        error_page 502 504 = @backend_unavailable;
        proxy_pass http://minicloud_app/;
    }

    location = /student/ {
        error_page 502 504 = @backend_unavailable;
        proxy_pass http://minicloud_app/student;
    }

    location = /student {
        error_page 502 504 = @backend_unavailable;
        proxy_pass http://minicloud_app/student;
    }

    location = /students-db {
        error_page 502 504 = @backend_unavailable;
        proxy_pass http://minicloud_app/students-db;
    }

    location @backend_unavailable {
        default_type application/json;
        return 503 '{"error":"backend_unavailable"}';
    }

    location = /auth {
        return 308 /auth/;
    }

    # Relative redirect keeps the browser on the same Gateway origin.
    location = /auth/ {
        return 302 /auth/realms/myminicloud/account/;
    }

    # Administration is available only on the loopback-published Keycloak port.
    location = /auth/admin { return 403; }
    location /auth/admin/ { return 403; }

    location /auth/ {
        proxy_pass http://minicloud_auth;
    }

    location / {
        proxy_pass http://minicloud_web;
    }
}
