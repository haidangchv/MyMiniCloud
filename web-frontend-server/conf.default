server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;
    absolute_redirect off;

    add_header X-Served-By $hostname always;

    # This constant gauge only reports that this Web endpoint answered.
    location = /metrics {
        default_type "text/plain; version=0.0.4";
        return 200 "# HELP web_up Web metrics endpoint answered successfully\n# TYPE web_up gauge\nweb_up 1\n";
    }

    location = /_web/node {
        default_type text/plain;
        return 200 "$hostname\n";
    }

    location = /node {
        default_type text/plain;
        return 200 "Web Server Node: $hostname\n";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location = /blog {
        return 301 /blog/;
    }

    location ^~ /blog/ {
        alias /usr/share/nginx/html/blog/;
        index index.html;
        autoindex off;
    }
}

server {
    listen 8082;
    server_name _;

    location = /stub_status {
        stub_status;
    }

    location / {
        return 404;
    }
}
