server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;
    absolute_redirect off;

    # Header giúp nhận diện container Web nào đang xử lý request (kiểm chứng Load Balancing Round Robin)
    add_header X-Served-By $hostname always;

    location / {
        try_files $uri $uri/ =404;
    }

    # Endpoint /metrics cho Prometheus (Muc 7 mo rong - TV4): target job "web"
    location = /metrics {
        default_type text/plain;
        return 200 "# HELP web_up Web frontend is up\n# TYPE web_up gauge\nweb_up 1\n";
    }

    location = /node {
        default_type text/plain;
        add_header X-Served-By $hostname always;
        return 200 "Web Server Node: $hostname\n";
    }

    location = /blog {
        return 301 /blog/;
    }

    location ^~ /blog/ {
        alias /usr/share/nginx/html/blog/;
        index index.html;
        autoindex off;
    }
}
